{
  "$comment": "The bundled default keymap (01 §8.1-§8.2): the set `default`. Platform-standard shortcuts of 01 §8.2 plus single-key or simple-modifier defaults for frequent operations (design work). `platforms` limits a binding to the listed platforms (windows, macos, linux). Tool keys (M4 C4.2): one single-key group key per tool group in the drawing context (02 §5.1 group cycling: pressing it again advances within the group). Conflict-free per context and platform (crates/executor/tests/c41/keymap.rs).",
  "set": "default",
  "version": 1,
  "bindings": [
    { "commandId": "project.create", "keys": "Primary+N", "context": "global" },
    { "commandId": "project.open", "keys": "Primary+O", "context": "global" },
    { "commandId": "project.save", "keys": "Primary+S", "context": "global" },
    { "commandId": "project.saveAs", "keys": "Primary+Shift+S", "context": "global" },
    { "commandId": "project.close", "keys": "Primary+W", "context": "global" },
    { "commandId": "app.quit", "keys": "Primary+Q", "context": "global" },
    { "commandId": "edit.undo", "keys": "Primary+Z", "context": "global" },
    { "commandId": "edit.redo", "keys": "Primary+Shift+Z", "context": "global" },
    { "commandId": "edit.redo", "keys": "Primary+Y", "context": "global", "platforms": ["windows", "linux"] },
    { "commandId": "edit.cut", "keys": "Primary+X", "context": "global" },
    { "commandId": "edit.copy", "keys": "Primary+C", "context": "global" },
    { "commandId": "edit.paste", "keys": "Primary+V", "context": "global" },
    { "commandId": "edit.pasteSpecial", "keys": "Primary+Shift+V", "context": "global" },
    { "commandId": "edit.delete", "keys": "Delete", "context": "global" },
    { "commandId": "edit.delete", "keys": "Backspace", "context": "global" },
    { "commandId": "edit.selectAll", "keys": "Primary+A", "context": "global" },
    { "commandId": "edit.deselectAll", "keys": "Primary+Shift+A", "context": "global" },
    { "commandId": "ui.preferences.open", "keys": "Primary+,", "context": "global", "platforms": ["macos"] },
    { "commandId": "ui.help.open", "keys": "Primary+Shift+/", "context": "global", "platforms": ["macos"] },
    { "commandId": "ui.help.open", "keys": "F1", "context": "global", "platforms": ["windows", "linux"] },
    { "commandId": "ui.contextHelpMode.set", "params": { "enabled": true }, "keys": "Shift+F1", "context": "global", "platforms": ["windows", "linux"] },
    { "commandId": "window.fullScreen.set", "keys": "Primary+Ctrl+F", "context": "global", "platforms": ["macos"] },
    { "commandId": "window.fullScreen.set", "keys": "F11", "context": "global", "platforms": ["windows", "linux"] },
    { "commandId": "window.minimized.set", "params": { "minimized": true }, "keys": "Primary+M", "context": "global", "platforms": ["macos"] },
    { "commandId": "print.run", "keys": "Primary+P", "context": "global" },

    { "commandId": "app.frame.move", "params": { "direction": "previous" }, "keys": ",", "context": "global" },
    { "commandId": "app.frame.move", "params": { "direction": "next" }, "keys": ".", "context": "global" },
    { "commandId": "app.frame.move", "params": { "direction": "previous", "unit": "drawing" }, "keys": "Shift+,", "context": "global" },
    { "commandId": "app.frame.move", "params": { "direction": "next", "unit": "drawing" }, "keys": "Shift+.", "context": "global" },
    { "commandId": "app.currentElement.move", "params": { "direction": "previous" }, "keys": "Alt+,", "context": "global" },
    { "commandId": "app.currentElement.move", "params": { "direction": "next" }, "keys": "Alt+.", "context": "global" },
    { "commandId": "playback.start", "keys": "Enter", "context": "global" },
    { "commandId": "playback.stop", "keys": "Shift+Enter", "context": "global" },

    { "commandId": "view.zoom.set", "params": { "steps": 1 }, "keys": "Primary+=", "context": "global" },
    { "commandId": "view.zoom.set", "params": { "steps": -1 }, "keys": "Primary+-", "context": "global" },
    { "commandId": "view.transform.reset", "params": { "parts": ["zoom"] }, "keys": "Primary+0", "context": "global" },
    { "commandId": "view.transform.reset", "params": { "parts": ["zoom", "rotation", "pan"] }, "keys": "Primary+Shift+0", "context": "global" },
    { "commandId": "view.rotation.set", "params": { "steps": -1 }, "keys": "Shift+[", "context": "global" },
    { "commandId": "view.rotation.set", "params": { "steps": 1 }, "keys": "Shift+]", "context": "global" },
    { "commandId": "view.transform.reset", "params": { "parts": ["rotation"] }, "keys": "Shift+\\", "context": "global" },
    { "commandId": "view.type.set", "params": { "type": "previous" }, "keys": "Primary+Alt+V", "context": "global" },

    { "commandId": "tool.group.select", "params": { "group": "select" }, "keys": "S", "context": "drawing" },
    { "commandId": "tool.group.select", "params": { "group": "brush" }, "keys": "B", "context": "drawing" },
    { "commandId": "tool.group.select", "params": { "group": "paint" }, "keys": "F", "context": "drawing" },
    { "commandId": "tool.group.select", "params": { "group": "eraser" }, "keys": "E", "context": "drawing" },
    { "commandId": "tool.group.select", "params": { "group": "navigate" }, "keys": "Z", "context": "drawing" },
    { "commandId": "tool.group.select", "params": { "group": "text" }, "keys": "T", "context": "drawing" },
    { "commandId": "window.panel.set", "params": { "panelId": "timeline" }, "keys": "Primary+Shift+T", "context": "global" },
    { "commandId": "window.panel.set", "params": { "panelId": "xsheet" }, "keys": "Primary+Shift+X", "context": "global" },
    { "commandId": "window.panel.set", "params": { "panelId": "colour" }, "keys": "Primary+Shift+C", "context": "global" },
    { "commandId": "window.panel.set", "params": { "panelId": "properties" }, "keys": "Primary+Shift+I", "context": "global" },
    { "commandId": "window.panel.set", "params": { "panelId": "history" }, "keys": "Primary+Shift+H", "context": "global" },
    { "commandId": "window.panel.set", "params": { "panelId": "library" }, "keys": "Primary+Shift+L", "context": "global" }
  ]
}
