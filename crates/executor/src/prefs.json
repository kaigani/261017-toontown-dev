{
  "$comment": "Preference catalogue (01 §7.2-§7.3; agent keys of 11 §4/§15; keys other sections and earlier kernel commands use). One entry per key: type (bool, int, number, string, enum, colour, path, object), default, min/max or values, applies (live, nextLaunch, restart), category (the Preferences window group), description. Read by crates/executor/src/prefs.rs; checked against 01 §7.3 by crates/executor/tests/c41_prefs.rs.",
  "version": 1,
  "categories": [
    { "id": "general", "label": "General" },
    { "id": "files", "label": "Files and safety" },
    { "id": "newProject", "label": "New-project defaults" },
    { "id": "interface", "label": "Interface" },
    { "id": "drawingAids", "label": "Drawing aids" },
    { "id": "display", "label": "Display" },
    { "id": "tablet", "label": "Tablet" },
    { "id": "staging", "label": "Staging" },
    { "id": "timing", "label": "Timing" },
    { "id": "edit", "label": "Edit" },
    { "id": "agent", "label": "Agent access" }
  ],
  "prefs": [
    { "key": "user.name", "type": "string", "default": "", "maxLength": 100, "applies": "live", "category": "general", "description": "Author name stamped into templates created afterwards; empty uses the operating system account's full name." },
    { "key": "user.copyright", "type": "string", "default": "", "maxLength": 200, "applies": "live", "category": "general", "description": "Copyright owner stamped into new templates." },
    { "key": "library.globalPath", "type": "path", "default": "", "applies": "live", "category": "general", "description": "Location of the global library; empty uses the per-user application library folder. Must be an existing writable folder." },
    { "key": "general.startup.behaviour", "type": "enum", "default": "startScreen", "values": ["startScreen", "lastProject", "openDialog", "newDialog", "newDefaultProject"], "applies": "nextLaunch", "category": "general", "description": "What happens at launch and after Close." },
    { "key": "general.language", "type": "enum", "default": "en", "values": ["en"], "applies": "restart", "category": "general", "description": "Interface language (installed localisations)." },
    { "key": "general.recentProjects.maxCount", "type": "int", "default": 10, "min": 0, "max": 30, "applies": "live", "category": "general", "description": "Length of the recent-projects list." },
    { "key": "general.workspace.autoSave", "type": "bool", "default": true, "applies": "live", "category": "general", "description": "Save the current workspace automatically before switching workspace and at quit." },

    { "key": "files.autosave.enabled", "type": "bool", "default": true, "applies": "live", "category": "files", "description": "Write periodic recovery copies of a modified project." },
    { "key": "files.autosave.intervalMinutes", "type": "int", "default": 5, "min": 1, "max": 60, "applies": "live", "category": "files", "description": "Autosave interval in minutes." },
    { "key": "files.backups.count", "type": "int", "default": 3, "min": 0, "max": 20, "applies": "live", "category": "files", "description": "Previous versions kept per project (0 = off)." },

    { "key": "project.defaults.frameRate", "type": "number", "default": 24, "min": 1, "max": 120, "applies": "live", "category": "newProject", "description": "Frame rate of the Default format of the new-project form." },
    { "key": "project.defaults.cameraWidth", "type": "int", "default": 1920, "min": 16, "max": 8192, "applies": "live", "category": "newProject", "description": "Camera width of the Default format." },
    { "key": "project.defaults.cameraHeight", "type": "int", "default": 1080, "min": 16, "max": 8192, "applies": "live", "category": "newProject", "description": "Camera height of the Default format." },

    { "key": "interface.theme", "type": "enum", "default": "system", "values": ["system", "light", "dark"], "userThemes": true, "applies": "live", "category": "interface", "description": "Interface theme; system follows the operating system appearance." },
    { "key": "interface.statusBar.visible", "type": "bool", "default": true, "applies": "live", "category": "interface", "description": "Show the status bar." },
    { "key": "interface.mainToolbar.visible", "type": "bool", "default": true, "applies": "live", "category": "interface", "description": "Show the main toolbar." },
    { "key": "interface.timeMeasurement", "type": "enum", "default": "frames", "values": ["frames", "feetAndFrames"], "applies": "live", "category": "interface", "description": "Timeline ruler and frame displays show frame numbers, or feet and frames (16 frames per foot)." },
    { "key": "interface.elementColours.drawing", "type": "colour", "default": "#8FD98FFF", "applies": "live", "category": "interface", "description": "Default marker colour of drawing elements." },
    { "key": "interface.elementColours.image", "type": "colour", "default": "#A8E0A8FF", "applies": "live", "category": "interface", "description": "Default marker colour of image elements." },
    { "key": "interface.elementColours.sound", "type": "colour", "default": "#B8A8D8FF", "applies": "live", "category": "interface", "description": "Default marker colour of sound elements." },
    { "key": "interface.elementColours.peg", "type": "colour", "default": "#8080FFFF", "applies": "live", "category": "interface", "description": "Default marker colour of peg elements." },
    { "key": "interface.elementColours.skeleton", "type": "colour", "default": "#6A8FB5FF", "applies": "live", "category": "interface", "description": "Default marker colour of skeleton elements." },
    { "key": "interface.elementColours.bone", "type": "colour", "default": "#7FA3C8FF", "applies": "live", "category": "interface", "description": "Default marker colour of bone elements." },
    { "key": "interface.elementColours.media", "type": "colour", "default": "#A0A050FF", "applies": "live", "category": "interface", "description": "Default marker colour of media (movie) elements." },
    { "key": "interface.elementColours.camera", "type": "colour", "default": "#FF8080FF", "applies": "live", "category": "interface", "description": "Default marker colour of camera elements." },
    { "key": "interface.elementColours.effect", "type": "colour", "default": "#C88040FF", "applies": "live", "category": "interface", "description": "Default marker colour of effect elements." },
    { "key": "interface.elementColours.effectParameter", "type": "colour", "default": "#A05030FF", "applies": "live", "category": "interface", "description": "Default marker colour of effect-parameter (mask and matte) elements." },
    { "key": "interface.storylineColours.scene", "type": "colour", "default": "#9CC3E6FF", "applies": "live", "category": "interface", "description": "Scene blocks in the storyline." },
    { "key": "interface.storylineColours.sceneWarning", "type": "colour", "default": "#F2A65AFF", "applies": "live", "category": "interface", "description": "Scene blocks with a warning in the storyline." },
    { "key": "interface.storylineColours.transition", "type": "colour", "default": "#C9C9C9FF", "applies": "live", "category": "interface", "description": "Transition blocks in the storyline." },
    { "key": "interface.background.timeline", "type": "colour", "default": "", "themeDefault": true, "applies": "live", "category": "interface", "description": "Timeline background; empty uses the theme's colour." },
    { "key": "interface.background.drawingView", "type": "colour", "default": "#FFFFFFFF", "applies": "live", "category": "interface", "description": "Background of the Drawing view, and of the Camera view when the scene background colour is not used." },

    { "key": "drawing.onionSkin.enabled", "type": "bool", "default": false, "applies": "live", "category": "drawingAids", "description": "Onion skin on or off." },
    { "key": "drawing.onionSkin.previousCount", "type": "int", "default": 1, "min": 0, "max": 3, "applies": "live", "category": "drawingAids", "description": "Number of previous drawings shown." },
    { "key": "drawing.onionSkin.nextCount", "type": "int", "default": 1, "min": 0, "max": 3, "applies": "live", "category": "drawingAids", "description": "Number of next drawings shown." },
    { "key": "drawing.onionSkin.transparency", "type": "bool", "default": false, "applies": "live", "category": "drawingAids", "description": "Onion-skin drawings are semi-transparent." },
    { "key": "drawing.onionSkin.colourShading", "type": "bool", "default": true, "applies": "live", "category": "drawingAids", "description": "Onion-skin drawings are tinted with the previous and next colours." },
    { "key": "drawing.onionSkin.previousColour", "type": "colour", "default": "#FF0000FF", "applies": "live", "category": "drawingAids", "description": "Tint of previous drawings." },
    { "key": "drawing.onionSkin.nextColour", "type": "colour", "default": "#00C000FF", "applies": "live", "category": "drawingAids", "description": "Tint of next drawings." },
    { "key": "drawing.onionSkin.outlineOnly", "type": "bool", "default": false, "applies": "live", "category": "drawingAids", "description": "Show onion-skin drawings as outlines." },
    { "key": "drawing.lightTable.staticShade", "type": "bool", "default": true, "applies": "live", "category": "drawingAids", "description": "Wash out drawings shown on the static light table." },
    { "key": "drawing.lightTable.autoShade", "type": "bool", "default": true, "applies": "live", "category": "drawingAids", "description": "Wash out drawings shown by the automatic light table." },
    { "key": "drawing.inspectorPreview", "type": "bool", "default": true, "applies": "live", "category": "drawingAids", "description": "Show the drawing preview in the Properties panel's Drawing tab (draw.inspectorPreview.set)." },
    { "key": "paint.gapClosing", "type": "enum", "default": "off", "values": ["off", "small", "medium", "large"], "applies": "live", "category": "drawingAids", "description": "Automatic gap closing of the paint tools (colour.gap.mode.set)." },

    { "key": "display.antiAliasing", "type": "bool", "default": true, "applies": "live", "category": "display", "description": "Anti-alias the whole view." },
    { "key": "display.smoothBitmaps", "type": "bool", "default": true, "applies": "live", "category": "display", "description": "Filtered sampling of bitmap images and texture fills on screen." },
    { "key": "display.smoothToolOverlays", "type": "bool", "default": true, "applies": "live", "category": "display", "description": "Anti-alias tool overlays (handles, rotation circle)." },
    { "key": "display.smoothMotionPaths", "type": "bool", "default": true, "applies": "live", "category": "display", "description": "Anti-alias motion paths in staging views." },
    { "key": "display.fastPencilRendering", "type": "bool", "default": false, "applies": "restart", "category": "display", "description": "Faster, approximate on-screen rendering of centre-line (pencil) strokes." },
    { "key": "display.bitmapPreviewMaxSize", "type": "int", "default": 0, "min": 0, "max": 8192, "excludedRange": [1, 255], "applies": "live", "category": "display", "description": "Maximum on-screen resolution (longest side, pixels) of bitmaps and textures: 0 (full) or 256 to 8192. Never affects export." },
    { "key": "display.cacheMemoryPercent", "type": "int", "default": 30, "min": 5, "max": 80, "applies": "live", "category": "display", "description": "Share of system memory used for display caches." },
    { "key": "display.sceneBackground.drawingView", "type": "bool", "default": false, "applies": "live", "category": "display", "description": "Use the scene background colour in the Drawing view." },
    { "key": "display.sceneBackground.stagingViews", "type": "bool", "default": true, "applies": "live", "category": "display", "description": "Use the scene background colour in staging views." },

    { "key": "tablet.ignore", "type": "bool", "default": false, "applies": "live", "category": "tablet", "description": "Treat the tablet as a mouse (no pressure or tilt)." },
    { "key": "tablet.alternativeInput", "type": "bool", "default": false, "applies": "restart", "category": "tablet", "description": "Use the alternative operating-system tablet input interface." },
    { "key": "tablet.portraitCorrection", "type": "bool", "default": false, "applies": "live", "category": "tablet", "description": "Correct coordinates and pressure on tablet computers used in portrait orientation." },

    { "key": "staging.motionPoint.defaultTension", "type": "number", "default": 0.0, "min": -1.0, "max": 1.0, "applies": "live", "category": "staging", "description": "Tension of newly created motion points (+1 = sharp corner)." },
    { "key": "staging.motionPoint.defaultContinuity", "type": "number", "default": 0.0, "min": -1.0, "max": 1.0, "applies": "live", "category": "staging", "description": "Continuity of new motion points." },
    { "key": "staging.motionPoint.defaultBias", "type": "number", "default": 0.0, "min": -1.0, "max": 1.0, "applies": "live", "category": "staging", "description": "Bias of new motion points." },
    { "key": "staging.units.showSuffix", "type": "bool", "default": true, "applies": "live", "category": "staging", "description": "Show the unit suffix next to coordinate values." },
    { "key": "staging.units.coordinate", "type": "enum", "default": "fields", "values": ["fields", "inches", "centimetres"], "applies": "live", "category": "staging", "description": "Unit for positions." },
    { "key": "staging.units.angle", "type": "enum", "default": "degrees", "values": ["degrees", "radians"], "applies": "live", "category": "staging", "description": "Unit for angles." },
    { "key": "staging.selection.boxHighlight", "type": "bool", "default": true, "applies": "live", "category": "staging", "description": "Draw a box around the selected element in the Camera view; when off the rest is faded." },
    { "key": "staging.selection.alwaysVisible", "type": "bool", "default": true, "applies": "live", "category": "staging", "description": "Show elements selected in the Timeline or exposure sheet even when they are hidden." },
    { "key": "staging.selection.outline", "type": "bool", "default": false, "applies": "live", "category": "staging", "description": "Draw the contour of the selected elements." },
    { "key": "staging.keyframes.linearVelocity", "type": "bool", "default": true, "applies": "live", "category": "staging", "description": "New peg functions get linear velocity; when off, a default ease-in and ease-out." },
    { "key": "staging.keyframes.constantByDefault", "type": "bool", "default": false, "applies": "live", "category": "staging", "description": "New keyframes are constant (no interpolation)." },
    { "key": "staging.keyframes.snapLastFrame", "type": "bool", "default": false, "applies": "live", "category": "staging", "description": "Snap the last keyframe to the last frame." },
    { "key": "staging.depthNudgeStep", "type": "number", "default": 0.01, "min": 0.0001, "max": 1.0, "applies": "live", "category": "staging", "description": "Depth-nudge step in fields (05 §6.4, §16)." },
    { "key": "staging.pegOnlyMode", "type": "bool", "default": false, "applies": "live", "category": "staging", "description": "Peg-only mode of the animation tools (05 §6.1, §16)." },

    { "key": "timing.timeline.singleCellSelection", "type": "bool", "default": true, "applies": "live", "category": "timing", "description": "A click selects one cell; when off, a click selects the whole track." },

    { "key": "edit.pasteSpecial.timeline", "type": "object", "default": { "overwriteDrawings": true, "createDeleteExposure": true, "extendExposures": false, "updateColours": true, "keyframeSubstitution": false, "motionKeys": true, "rotationKeys": true, "scaleKeys": true, "pivotKeys": true, "velocityKeys": true, "skewKeys": true, "boundaryKeys": false }, "objectOf": "bool", "applies": "live", "category": "edit", "description": "Remembered paste-special options." },
    { "key": "edit.cutSpecial.timeline", "type": "object", "default": { "overwriteDrawings": true, "createDeleteExposure": true, "extendExposures": false, "updateColours": true, "keyframeSubstitution": false, "motionKeys": true, "rotationKeys": true, "scaleKeys": true, "pivotKeys": true, "velocityKeys": true, "skewKeys": true, "boundaryKeys": false }, "objectOf": "bool", "applies": "live", "category": "edit", "description": "Remembered cut-special options." },
    { "key": "edit.dragDrop.timeline", "type": "object", "default": { "overwriteDrawings": true, "createDeleteExposure": true, "extendExposures": false, "updateColours": true, "keyframeSubstitution": false, "motionKeys": true, "rotationKeys": true, "scaleKeys": true, "pivotKeys": true, "velocityKeys": true, "skewKeys": true, "boundaryKeys": false }, "objectOf": "bool", "applies": "live", "category": "edit", "description": "Options for dragging cells in the Timeline." },
    { "key": "edit.pasteSpecial.motionPoint", "type": "object", "default": { "x": true, "y": true, "z": true, "tension": true, "continuity": true, "bias": true, "angle": true, "rotationPivot": true, "scaleX": true, "scaleY": true, "scalePivot": true }, "objectOf": "bool", "applies": "live", "category": "edit", "description": "Remembered motion-point paste-special options." },

    { "key": "agent.server.enabled", "type": "bool", "default": false, "applies": "live", "category": "agent", "description": "Run the agent (MCP) server for attached mode. Off by default (11 §4)." },
    { "key": "agent.server.port", "type": "int", "default": 47215, "min": 1024, "max": 65535, "applies": "live", "category": "agent", "description": "Loopback port of the Streamable HTTP endpoint; the next free port is used when it is taken." },
    { "key": "agent.server.allowRemote", "type": "bool", "default": false, "applies": "live", "category": "agent", "description": "Allow non-loopback binding (needs the MCP authorization flow; off by default)." },
    { "key": "agent.policy.defaults", "type": "object", "default": { "policy": "assist", "maxJobs": 2, "maxBatchSteps": 1000, "maxInlineImagePx": 2048, "maxInlineBytes": 52428800, "askInApp": true, "letAgentMoveView": true, "highlightAgentChanges": true }, "applies": "live", "category": "agent", "description": "Default policy and limits for new agent sessions (agent.policy.defaults.set)." }
  ]
}
