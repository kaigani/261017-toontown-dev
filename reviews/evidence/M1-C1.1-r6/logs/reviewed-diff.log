diff --git a/crates/model/src/change.rs b/crates/model/src/change.rs
index 90cf819..01e1688 100644
--- a/crates/model/src/change.rs
+++ b/crates/model/src/change.rs
@@ -589,10 +589,92 @@ pub fn apply_with_inverse(value: &Value, patch: &[PatchOp]) -> Result<(Value, Ve
     let mut steps: Vec<Vec<PatchOp>> = Vec::with_capacity(patch.len());
     for op in patch {
         steps.push(apply_op(&mut v, op)?);
+        // The post-condition on the staged value is the guarantee, whatever the operation or path shape (C11-R5-01).
+        check_frame_fields(&v, op)?;
     }
     Ok((v, steps.into_iter().rev().flatten().collect()))
 }
 
+/// Post-condition of one applied operation on the staged value (C11-R5-01): every declared frame-bearing field the
+/// operation can have changed — one containing a written path (a run count written below `exposure`, an append to
+/// it), the written path itself (a whole mouth string, a copy or move into `exposure`), or one inside the written
+/// value (a whole placement or element replaced) — satisfies its invariants: exposure runs with counts ≥ 1 and at
+/// most a scene's frames, mouth strings of at most a scene's frames (10 §4.7, §4.14, §5). A failure is the typed
+/// error of the operation (`doc.limitExceeded` or `arg.invalid` with `details.pointer`), and because the patch is
+/// applied to a staged copy, nothing of it is applied. Fields inside opaque `meta`/`ext` are not declared fields.
+fn check_frame_fields(v: &Value, op: &PatchOp) -> Result<(), ModelError> {
+    for written in std::iter::once(&op.path).chain(op.from.as_ref()) {
+        let tokens = pointer::parse(written)?;
+        // A trailing `-` names the element an append created; its container is what changed.
+        let concrete = match tokens.split_last() {
+            Some((last, parent)) if last == "-" => parent,
+            _ => tokens.as_slice(),
+        };
+        for depth in 0..=concrete.len() {
+            let prefix = concrete.get(..depth).unwrap_or_default();
+            if let Some(field) = declared_frame_field(prefix)
+                && let Some(value) = pointer::get(v, prefix)
+            {
+                check_frame_field(field, value, op)?;
+            }
+        }
+        if let Some(value) = pointer::get(v, concrete) {
+            scan_frame_fields(value, &mut concrete.to_vec(), op, 0)?;
+        }
+    }
+    Ok(())
+}
+
+fn scan_frame_fields(v: &Value, at: &mut Vec<String>, op: &PatchOp, depth: usize) -> Result<(), ModelError> {
+    if depth > crate::MAX_JSON_DEPTH || at.iter().any(|t| t == "meta" || t == "ext") {
+        return Ok(());
+    }
+    if let Some(field) = declared_frame_field(at) {
+        check_frame_field(field, v, op)?;
+    }
+    match v {
+        Value::Object(m) => {
+            for (k, x) in m {
+                if matches!(x, Value::Object(_) | Value::Array(_) | Value::String(_)) {
+                    at.push(k.clone());
+                    let r = scan_frame_fields(x, at, op, depth + 1);
+                    at.pop();
+                    r?;
+                }
+            }
+        }
+        // Exposure tuples and other arrays of scalars hold no further declared fields.
+        Value::Array(items) => {
+            for (i, x) in items.iter().enumerate() {
+                if matches!(x, Value::Object(_)) {
+                    at.push(i.to_string());
+                    let r = scan_frame_fields(x, at, op, depth + 1);
+                    at.pop();
+                    r?;
+                }
+            }
+        }
+        _ => {}
+    }
+    Ok(())
+}
+
+fn check_frame_field(field: &str, v: &Value, op: &PatchOp) -> Result<(), ModelError> {
+    match (field, v) {
+        ("exposure", Value::Array(_)) => runs_total(v, "the exposure", op).map(drop),
+        ("mouths", Value::String(s)) => {
+            // Byte length bounds the letter count from above; count only when it could exceed the limit.
+            if s.len() as u64 > MAX_FRAMES && s.chars().count() as u64 > MAX_FRAMES {
+                Err(limit_err(op, format!("the mouth track would exceed {MAX_FRAMES} frames (10 §5)")))
+            } else {
+                Ok(())
+            }
+        }
+        // Other shapes are the schema's to reject when the object is validated.
+        _ => Ok(()),
+    }
+}
+
 fn patch_err(op: &PatchOp, msg: impl Into<String>) -> ModelError {
     ModelError::with_details(codes::ARG_INVALID, msg, json!({ "pointer": op.path, "op": op.op }))
 }
diff --git a/crates/model/src/document/mod.rs b/crates/model/src/document/mod.rs
index 2543cfd..8048269 100644
--- a/crates/model/src/document/mod.rs
+++ b/crates/model/src/document/mod.rs
@@ -405,6 +405,81 @@ impl Document {
         self.entry_raw(key)
     }
 
+    /// Applies a patch to one entry as a **staged commit** (10 §2.6, §5; C11-R5-01) and returns the next snapshot
+    /// with the patch's inverse.
+    ///
+    /// The patch is applied to a copy of the entry's JSON (`change::apply_with_inverse`, which already checks every
+    /// frame-bearing field an operation touched). The staged entry then goes through the full input path again
+    /// (`object::from_json`: depth limit, normalisation, schema, canonical form, object-local rules, including the
+    /// exposure and scene limits), replaces the entry in a copy-on-write clone, and the clone's complete `issues()` —
+    /// every integrity rule and every 10 §5 limit — must have no error. Only then is the staged snapshot returned;
+    /// `self` is immutable and is never changed. This post-condition is the guarantee, whatever operations or paths
+    /// the patch uses; the cheap per-operation checks are fast paths.
+    ///
+    /// # Errors
+    /// The first failing stage's errors: the patch's typed error (e.g. `doc.limitExceeded`, `arg.invalid`,
+    /// `doc.patchTestFailed`, with `details.pointer`), the entry's input errors (`doc.schemaViolation`,
+    /// `arg.invalid`, `doc.limitExceeded`; `details.objectId`), an attempt to change the entry's ID (`arg.invalid`,
+    /// ID-01), or the integrity errors of the staged document (codes of 10 §9 with `details.objectId` and
+    /// `details.pointer`).
+    pub fn with_patched_entry(
+        &self,
+        key: &EntryKey,
+        patch: &[crate::change::PatchOp],
+    ) -> Result<(Document, Vec<crate::change::PatchOp>), Vec<ModelError>> {
+        fn staged<T: crate::entities::ModelObject + Check>(
+            v: &serde_json::Value,
+            id: &Id,
+        ) -> Result<T, Vec<ModelError>> {
+            let parsed: T = crate::object::from_json(v).map_err(|errors| {
+                errors
+                    .into_iter()
+                    .map(|e| {
+                        let mut details = e.details().clone();
+                        if let Some(m) = details.as_object_mut() {
+                            m.insert("objectId".into(), json!(id.as_str()));
+                        }
+                        ModelError::with_details(e.code(), e.message().to_owned(), details)
+                    })
+                    .collect::<Vec<_>>()
+            })?;
+            if parsed.object_id() != id {
+                return Err(vec![ModelError::with_details(
+                    codes::ARG_INVALID,
+                    format!("the id of `{id}` is immutable (10 ID-01)"),
+                    json!({ "objectId": id.as_str(), "pointer": format!("/{}", T::TYPE.id_field()) }),
+                )]);
+            }
+            Ok(parsed)
+        }
+        let before = self.entry_raw_json(key).map_err(|e| vec![e])?;
+        let (after, inverse) = crate::change::apply_with_inverse(&before, patch).map_err(|e| vec![e])?;
+        let mut next = self.clone();
+        match key {
+            EntryKey::Project => next.project = Arc::new(staged(&after, &self.project.id)?),
+            EntryKey::Library => next.library = Arc::new(staged(&after, &self.library.id)?),
+            EntryKey::Palette(id) => {
+                next.palettes.insert(id.clone(), Arc::new(staged(&after, id)?));
+            }
+            EntryKey::Bank(id) => {
+                next.banks.insert(id.clone(), Arc::new(staged(&after, id)?));
+            }
+            EntryKey::Drawing(id) => {
+                next.drawings.insert(id.clone(), Arc::new(staged(&after, id)?));
+            }
+            EntryKey::Scene(id) => {
+                next.scenes.insert(id.clone(), Arc::new(staged(&after, id)?));
+            }
+            EntryKey::Element(id) => {
+                next.elements.insert(id.clone(), Arc::new(staged(&after, id)?));
+            }
+        }
+        next.rebuild_derived();
+        let errors: Vec<ModelError> =
+            next.issues().into_iter().filter(|i| i.severity == Severity::Error).map(|i| i.to_error()).collect();
+        if errors.is_empty() { Ok((next, inverse)) } else { Err(errors) }
+    }
+
     /// Where an object lives (by plain or compound ID string).
     #[must_use]
     pub fn locate(&self, id: &str) -> Option<&Location> {
diff --git a/crates/model/tests/staged_commit.rs b/crates/model/tests/staged_commit.rs
new file mode 100644
index 0000000..79f73ed
--- /dev/null
+++ b/crates/model/tests/staged_commit.rs
@@ -0,0 +1,247 @@
+//! C11-R5-01: a patch is committed only through a staged copy whose full integrity check passes.
+//!
+//! Random RFC 6902 sequences (add with overwrite or `-` append, remove, replace, move, copy, test) are applied to a
+//! random entry of a seeded sample document through `Document::with_patched_entry`. Values are drawn from a pool
+//! that includes frame-limit edge cases (100 000 / 100 001 frames, huge counts, zero counts, long mouth strings),
+//! invalid names, wrong types and ID changes. Whatever the outcome, the original document stays byte-identical, and
+//! a committed document never has an error-severity issue.
+#![allow(clippy::unwrap_used, clippy::panic, reason = "test helpers")]
+
+use proptest::prelude::*;
+use serde_json::{Value, json};
+use tt_model::change::{self, PatchOp};
+use tt_model::document::{Document, EntryKey, Severity};
+use tt_model::{fixture, pointer};
+
+struct Rng(u64);
+
+impl Rng {
+    fn next(&mut self) -> u64 {
+        self.0 ^= self.0 << 13;
+        self.0 ^= self.0 >> 7;
+        self.0 ^= self.0 << 17;
+        self.0
+    }
+
+    fn below(&mut self, n: usize) -> usize {
+        (self.next() % n.max(1) as u64) as usize
+    }
+}
+
+fn all_pointers(v: &Value, at: &mut Vec<String>, out: &mut Vec<Vec<String>>) {
+    out.push(at.clone());
+    match v {
+        Value::Array(a) => {
+            for (i, x) in a.iter().enumerate() {
+                at.push(i.to_string());
+                all_pointers(x, at, out);
+                at.pop();
+            }
+        }
+        Value::Object(m) => {
+            for (k, x) in m {
+                at.push(k.clone());
+                all_pointers(x, at, out);
+                at.pop();
+            }
+        }
+        _ => {}
+    }
+}
+
+fn value(rng: &mut Rng, current: Option<&Value>) -> Value {
+    match rng.below(16) {
+        0 => json!(100_000),
+        1 => json!(100_001),
+        2 => json!(50_001),
+        3 => json!(0),
+        4 => json!(2_147_483_648u64),
+        5 => json!([["dr_staged", 100_001]]),
+        6 => json!([[null, 1]]),
+        7 => json!(["dr_staged", 1]),
+        8 => json!("G".repeat(if rng.below(4) == 0 { 100_001 } else { 3 })),
+        9 => json!("  Renamed  "),
+        10 => json!("bad/name"),
+        11 => Value::Null,
+        12 => json!({"k": 1}),
+        13 => json!(true),
+        // Small perturbations of the current value keep many patches valid.
+        14 => match current {
+            Some(Value::Number(n)) if n.is_u64() => json!(n.as_u64().unwrap_or(0) + 1),
+            Some(Value::String(s)) => json!(format!("{s}x")),
+            Some(v) => v.clone(),
+            None => json!(1),
+        },
+        _ => json!(rng.below(10)),
+    }
+}
+
+/// A random patch of up to `n` operations that applies to `doc` as JSON (operations that do not apply are skipped).
+fn random_patch(doc: &Value, rng: &mut Rng, n: usize) -> Vec<PatchOp> {
+    let op = |kind: &'static str, path: String, from: Option<String>, value: Option<Value>, old: Option<Value>| {
+        PatchOp { op: kind, path, from, value, old_value: old, range: None, elided: false }
+    };
+    let mut state = doc.clone();
+    let mut patch = Vec::new();
+    for _ in 0..n * 4 {
+        if patch.len() == n {
+            break;
+        }
+        let mut ptrs = Vec::new();
+        all_pointers(&state, &mut Vec::new(), &mut ptrs);
+        let p = ptrs[rng.below(ptrs.len())].clone();
+        let current = pointer::get(&state, &p).cloned();
+        let candidate = match rng.below(7) {
+            // Replace (the most common edit), also the root's members.
+            0 | 1 => Some(op("replace", pointer::join(&p), None, Some(value(rng, current.as_ref())), current.clone())),
+            2 => match &current {
+                Some(Value::Array(a)) => {
+                    let mut q = p.clone();
+                    q.push(if rng.below(2) == 0 { "-".into() } else { rng.below(a.len() + 1).to_string() });
+                    Some(op("add", pointer::join(&q), None, Some(value(rng, None)), None))
+                }
+                Some(Value::Object(m)) => {
+                    let mut q = p.clone();
+                    let key = m.keys().nth(rng.below(m.len() + 1)).cloned().unwrap_or_else(|| "extra".into());
+                    let old = m.get(&key).cloned();
+                    q.push(key);
+                    Some(op("add", pointer::join(&q), None, Some(value(rng, None)), old))
+                }
+                _ => None,
+            },
+            3 if !p.is_empty() => Some(op("remove", pointer::join(&p), None, None, current.clone())),
+            4 if !p.is_empty() => {
+                let to = ptrs[rng.below(ptrs.len())].clone();
+                (!to.is_empty()).then(|| {
+                    op("move", pointer::join(&to), Some(pointer::join(&p)), None, pointer::get(&state, &to).cloned())
+                })
+            }
+            5 => {
+                let to = ptrs[rng.below(ptrs.len())].clone();
+                (!to.is_empty()).then(|| {
+                    op("copy", pointer::join(&to), Some(pointer::join(&p)), None, pointer::get(&state, &to).cloned())
+                })
+            }
+            _ => Some(op("test", pointer::join(&p), None, current.clone(), None)),
+        };
+        if let Some(o) = candidate
+            && let Ok(s) = change::apply(&state, std::slice::from_ref(&o))
+        {
+            state = s;
+            patch.push(o);
+        }
+    }
+    patch
+}
+
+/// Every entry's raw JSON, as bytes.
+fn snapshot_bytes(doc: &Document) -> Vec<(EntryKey, Vec<u8>)> {
+    doc.entry_keys()
+        .into_iter()
+        .map(|k| {
+            let bytes = serde_json::to_vec(&doc.entry_raw_json(&k).unwrap()).unwrap();
+            (k, bytes)
+        })
+        .collect()
+}
+
+/// Runs one random case; returns whether the patch was committed.
+fn case(seed: u64) -> bool {
+    let mut rng = Rng(seed | 1);
+    let doc = fixture::sample_document(1 + rng.next() % 4).unwrap();
+    let keys = doc.entry_keys();
+    let key = keys[rng.below(keys.len())].clone();
+    let entry = doc.entry_raw_json(&key).unwrap();
+    let n = 1 + rng.below(6);
+    let patch = random_patch(&entry, &mut rng, n);
+    let before = snapshot_bytes(&doc);
+    let result = doc.with_patched_entry(&key, &patch);
+    assert_eq!(snapshot_bytes(&doc), before, "the original document must stay byte-identical");
+    match result {
+        Ok((next, inverse)) => {
+            let errors: Vec<_> = next.issues().into_iter().filter(|i| i.severity == Severity::Error).collect();
+            assert!(errors.is_empty(), "committed a document with errors: {errors:?}\npatch {patch:?}");
+            // The returned inverse is concrete (computed against the staged pre-state).
+            assert!(inverse.iter().all(|o| !o.path.ends_with("/-")));
+            true
+        }
+        Err(errors) => {
+            assert!(!errors.is_empty());
+            for e in &errors {
+                assert!(e.details().get("pointer").is_some(), "error without details.pointer: {e:?}");
+            }
+            false
+        }
+    }
+}
+
+proptest! {
+    #![proptest_config(ProptestConfig { cases: 256, failure_persistence: None, ..ProptestConfig::default() })]
+
+    #[test]
+    fn random_patches_never_commit_a_document_with_integrity_errors(seed in any::<u64>()) {
+        case(seed);
+    }
+}
+
+/// The deterministic sweep shows both outcomes occur: random patches are committed and refused.
+#[test]
+fn staged_commit_sweep_commits_and_refuses() {
+    let (mut committed, mut refused) = (0, 0);
+    for seed in 0..1500u64 {
+        if case(seed.wrapping_mul(0x9E37_79B9_7F4A_7C15)) {
+            committed += 1;
+        } else {
+            refused += 1;
+        }
+    }
+    println!("staged commit sweep: {committed} committed, {refused} refused");
+    assert!(committed > 50 && refused > 50, "{committed} committed, {refused} refused");
+}
+
+/// The four reviewer shapes also hold at the document level: an element's exposure, a placement's mouth string.
+#[test]
+fn document_level_frame_writes_are_refused_and_leave_the_document_unchanged() {
+    let doc = fixture::sample_document(1).unwrap();
+    let mut checked = std::collections::BTreeSet::new();
+    for key in doc.entry_keys() {
+        let EntryKey::Element(_) = &key else { continue };
+        let v = doc.entry_raw_json(&key).unwrap();
+        let before = snapshot_bytes(&doc);
+        let mut patches = Vec::new();
+        if v.get("exposure").and_then(Value::as_array).is_some_and(|a| !a.is_empty()) {
+            patches.push(PatchOp {
+                op: "replace",
+                path: "/exposure/0/1".into(),
+                from: None,
+                value: Some(json!(100_001)),
+                old_value: None,
+                range: None,
+                elided: false,
+            });
+        }
+        if let Some(placements) = v.get("placements").and_then(Value::as_array) {
+            for (i, placement) in placements.iter().enumerate() {
+                if placement.get("mouthTrack").is_some_and(Value::is_object) {
+                    patches.push(PatchOp {
+                        op: "replace",
+                        path: format!("/placements/{i}/mouthTrack/mouths"),
+                        from: None,
+                        value: Some(json!("G".repeat(100_001))),
+                        old_value: None,
+                        range: None,
+                        elided: false,
+                    });
+                }
+            }
+        }
+        for p in patches {
+            let errors = doc.with_patched_entry(&key, std::slice::from_ref(&p)).unwrap_err();
+            assert_eq!(errors[0].code(), "doc.limitExceeded", "{errors:?}");
+            assert_eq!(errors[0].details()["pointer"], json!(p.path));
+            assert_eq!(snapshot_bytes(&doc), before);
+            checked.insert(if p.path.ends_with("mouths") { "mouths" } else { "exposure" });
+        }
+    }
+    assert_eq!(checked.len(), 2, "the fixture must exercise both fields: {checked:?}");
+}
