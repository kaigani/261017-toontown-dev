+/// Whether a point lies inside a closed polygon (non-zero winding).
+fn inside_poly(poly: &[F2], p: F2) -> bool {
+    let mut w = 0;
+    for i in 0..poly.len() {
+        let (a, b) = (poly[i], poly[(i + 1) % poly.len()]);
+        let o = (b.0 - a.0) * (p.1 - a.1) - (b.1 - a.1) * (p.0 - a.0);
+        if a.1 <= p.1 {
+            if b.1 > p.1 && o > 0.0 {
+                w += 1;
+            }
+        } else if b.1 <= p.1 && o < 0.0 {
+            w -= 1;
+        }
+    }
+    w != 0
+}
