+class Malformed(ValueError):
+    """An input the comparison cannot align soundly."""
+
+
+def check_identities(x, path, what):
+    """Refuses duplicate identities in every array the comparison aligns by ID (C24-R3-03: aligning would silently keep
+    one of the duplicates and could hide a change in another)."""
+    if isinstance(x, dict):
+        for k, v in x.items():
+            check_identities(v, f"{path}.{k}" if path else k, what)
+    elif isinstance(x, list):
+        ids = [e["id"] for e in x if isinstance(e, dict) and "id" in e]
+        seen = set()
+        for i in ids:
+            key = json.dumps(i, sort_keys=True)
+            if key in seen:
+                raise Malformed(f"{what}: duplicate id {i!r} in the array at {path or '(root)'}")
+            seen.add(key)
+        for k, e in enumerate(x):
+            check_identities(e, f"{path}[{k}]", what)
+
