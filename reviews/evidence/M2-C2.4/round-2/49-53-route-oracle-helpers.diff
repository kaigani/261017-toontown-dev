+/// C24-R2 (XOR-5D point-move seed, shrunk): moving a junction leaves a new zone of 1.33 du² whose overlap with the old
+/// zone beside it (0.10 du²) is snapping noise — above the boundary length inside the old box but below twice it, the
+/// documented bound (ADR-0017 history 5), which the product had halved — so the zone takes the fill of the old zone
+/// holding its published interior point, which lies in that sliver (the oracle's own probe lies outside every old zone).
+#[test]
+fn a_snapping_sliver_below_the_documented_bound_carries_no_fill() {
+    let list = vec![(false, vec![(1, 0), (4, 4)]), (true, vec![(4, 0), (1, 2)]), (true, vec![(2, 1), (3, 4), (0, 1)])];
+    let h = fresh();
+    let (d, layer, old) = setup(&h, &list).unwrap().unwrap();
+    let (strokes, _) = read(&h, &d, &layer);
+    let at = (2816, 2048);
+    let target = strokes.iter().find(|s| s.anchors.first() == Some(&at)).unwrap();
+    let off = (STEP * GRID, -STEP * GRID);
+    let q = to_pt((at.0 + off.0, at.1 + off.1));
+    let mut after = old.segs.clone();
+    for m in strokes.iter().filter(|s| s.anchors.contains(&at)) {
+        after = without(&after, &segments_of(std::slice::from_ref(m)));
+        let ring: Vec<Pt> = m.anchors.iter().map(|&a| if a == at { q.clone() } else { to_pt(a) }).collect();
+        for w in ring.windows(2) {
+            after.push((w[0].clone(), w[1].clone()));
+        }
+    }
+    assert!(safe(&after));
+    ok(
+        &h,
+        "draw.point.move",
+        json!({ "drawingId": d, "points": [{ "strokeId": target.id, "anchor": 0 }],
+                "delta": { "x": STEP, "y": -STEP }, "snap": false }),
+    );
+    let (strokes, zones) = read(&h, &d, &layer);
+    check(&strokes, &zones, &after, &carried(&old, &after)).unwrap();
+    let sliver = zones.iter().find(|z| z.area == 1.32861328125).unwrap();
+    let holder = old.arr.locate(&sliver.interior).unwrap();
+    assert_eq!(sliver.colour, old.fills[holder]);
+    assert!(sliver.colour.is_some());
+}
