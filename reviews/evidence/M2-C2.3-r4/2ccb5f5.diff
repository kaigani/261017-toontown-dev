+  # The six C1.2-C1.4 10 000-operation history oracles in release (moved from `check` in M2 C2.3 round 1, split out of
+  # `headless` in round 3: Windows `headless` passed its 55-minute budget in run 41363091264). Same assertions; each
+  # oracle's output is kept as an artifact.
+  history-oracles:
+    name: history oracles release (${{ matrix.os }})
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [windows-latest, macos-latest]
+    runs-on: ${{ matrix.os }}
+    timeout-minutes: 40
+    steps:
+      - uses: actions/checkout@v7
+
+      - name: Rust toolchain (pinned in rust-toolchain.toml)
+        run: |
+          tc=$(sed -n 's/^channel = "\(.*\)"/\1/p' rust-toolchain.toml)
+          rustup toolchain install "$tc" --profile minimal
+          rustup override set "$tc"
+          rustc --version
+
+      - uses: Swatinem/rust-cache@v2
+        with:
+          key: history-oracles
+
+      - name: C1.2-C1.4 10 000-operation history oracles (release; executor and MCP)
+        run: |
+          mkdir -p out
+          cargo test --release --locked -p tt-executor --test c12_r1_stress --test c12_r3_stress --test c13_r3_history_r1 --test c13_r3_history_r3 -- ten_thousand_history_operations_match_independent_content_oracle_and_replay --exact --nocapture 2>&1 | tee out/history-oracles-executor.log
+          cargo test --release --locked -p tt-mcp --test c14_r3_history_r1 --test c14_r3_history_r3 -- ten_thousand_history_operations_match_independent_content_oracle_and_replay --exact --nocapture 2>&1 | tee out/history-oracles-mcp.log
+
+      - uses: actions/upload-artifact@v7
+        if: always()
+        with:
+          name: history-oracles-${{ runner.os }}
+          path: out/
+          if-no-files-found: error
+
   # Unsigned desktop bundles + automated IPC round-trip benchmark in the real webview.
   bundle:
     name: bundle (${{ matrix.os }})
