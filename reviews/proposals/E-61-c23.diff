+/// Shows the drawing inspector's preview (`drawing.inspectorPreview`) through an executor with an ordinary budget on the
+/// test's user folder; the 200 ms executor started after it reads the preference (ruling E-61, D-71 item 3, D-45: the
+/// setup call's atomic preferences write passed the 200 ms budget on a CI runner, run 45447170146).
+fn preview_shown() {
+    let setup = ExecutorHandle::spawn_with_options(tt_executor::ExecutorOptions {
+        config: ExecutorConfig { budget: Duration::from_secs(30) },
+        persist: tt_executor::PersistOptions {
+            user_dirs: Some(tt_executor::UserDirs::under(&user_dir())),
+            ..Default::default()
+        },
+    })
+    .unwrap();
+    ok(&setup, "draw.inspectorPreview.set", json!({"visible":true}));
+}
+
+/// The 200 ms executor shows the preview as the setup left it: the batch's `visible: false` step is a change to roll
+/// back, not a call that changes nothing.
+fn assert_preview_shown(h: &ExecutorHandle) {
+    let got = ok(h, "prefs.get", json!({"keys":["drawing.inspectorPreview"]}));
+    assert_eq!(got["values"]["drawing.inspectorPreview"], true, "{got}");
+}
+
